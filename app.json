{
  "expo": {
    "name": "Salah 786",
    "slug": "Salah786",
    "scheme": "salah786",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/app_logo.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF8F3",
    "jsEngine": "hermes",
    "splash": {
      "image": "./src/assets/images/app_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F3"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "leanback",
      "barStyle": "light-content",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to calculate Qibla direction toward Makkah."
      },
      "splash": {
        "image": "./src/assets/images/app_logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFF8F3",
        "tabletImage": "./src/assets/images/app_logo.png"
      },
      "bundleIdentifier": "com.salah786.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/app_logo.png",
        "backgroundColor": "#FFF8F3"
      },
      "splash": {
        "image": "./src/assets/images/app_logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFF8F3"
      },
      "package": "com.salah786.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to calculate Qibla direction toward Makkah."
        }
      ]
    ]
  }
}
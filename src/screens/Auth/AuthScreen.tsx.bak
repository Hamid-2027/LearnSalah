  },
  guestBtn: {
    borderRadius: 14,
    backgroundColor: 'rgba(34, 211, 238, 0.05)',
    borderWidth: 1,
    borderColor: 'rgba(34, 211, 238, 0.25)',
    padding: 12,
  },
  guestInner: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 12,
  },
  guestIconBadge: {
    width: 34,
    height: 34,
    borderRadius: 17,
    backgroundColor: 'rgba(34, 211, 238, 0.15)',
    alignItems: 'center',
    justifyContent: 'center',
  },
  guestTitle: {
    color: '#ffffff',
    fontSize: 14,
    fontWeight: '700',
    marginBottom: 2,
  },
  guestSub: {
    color: C.textSecondary,
    fontSize: 11,
